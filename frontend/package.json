{
  "name": "instakill-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit --allowJs --checkJs --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --skipLibCheck src/*.jsx",
    "test:e2e": "playwright test",
    "format": "prettier --write src vite.config.js playwright.config.js tests"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
